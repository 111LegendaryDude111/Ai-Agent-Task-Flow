{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subtask.schema.json",
  "title": "AutoFlow Subtask Artifact",
  "type": "object",
  "required": [
    "id",
    "seq",
    "title",
    "status",
    "depends_on",
    "parallel",
    "context_files",
    "acceptance_criteria",
    "deliverables",
    "verification_spec",
    "agent_id",
    "started_at",
    "completed_at",
    "completion_summary"
  ],
  "properties": {
    "id": { "type": "string" },
    "seq": { "type": "string", "pattern": "^\\d{2}$" },
    "title": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "blocked", "cancelled"] },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "parallel": { "type": "boolean" },
    "suggested_agent": { "type": "string" },
    "context_files": { "type": "array" },
    "reference_files": { "type": "array" },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "deliverables": { "type": "array", "items": { "type": "string" } },
    "verification_spec": { "type": "object" },
    "agent_id": { "type": ["string", "null"] },
    "started_at": { "type": ["string", "null"] },
    "completed_at": { "type": ["string", "null"] },
    "completion_summary": { "type": ["string", "null"] },
    "verification": { "type": "object" },
    "autoflow": { "type": "object" },
    "blocked_reason": { "type": "string" },
    "cancelled_reason": { "type": "string" }
  },
  "additionalProperties": true
}
