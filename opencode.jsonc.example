{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4-flash",
  "default_agent": "synapse",
  "provider": {
    "local-ollama": {
      "name": "Local Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "gpt-oss:20b": {
          "name": "gpt-oss:20b",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3:4b": {
          "name": "Qwen3 4B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 128000,
            "output": 16000
          }
        }
      },
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "mcp": {
    "docker": {
      "type": "local",
      "command": [
        "docker",
        "mcp",
        "gateway",
        "run"
      ],
      "enabled": false
    },
    "browser": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/davidsukhashvili/Documents/Obsidian_storage"
      ],
      "enabled": true
    },
    "colab-proxy-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "git+https://github.com/googlecolab/colab-mcp"
      ],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "enabled": false,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "duckduckgo-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    }
  },
  "agent": {
    "synapse": {
      "description": "Provider-neutral orchestrator for context-first, rule-routed development",
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "{file:./agent/core/sfa-synapse.md}",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": {
          "rm -rf /*": "deny",
          "sudo *": "deny",
          "> /dev/*": "deny",
          "* > /dev/*": "deny",
          "* >> /dev/*": "deny",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "rm *": "ask",
          "chmod *": "ask",
          "chown *": "ask",
          "curl *": "ask",
          "wget *": "ask",
          "npm install*": "ask",
          "npm i *": "ask",
          "pnpm add*": "ask",
          "yarn add*": "ask",
          "bun add*": "ask",
          "git push*": "ask",
          "git reset*": "ask",
          "git clean*": "ask",
          "*": "ask"
        },
        "write": "allow",
        "task": "allow",
        "question": "allow"
      }
    },
    "ContextScout": {
      "description": "Read-only context discovery subagent",
      "mode": "subagent",
